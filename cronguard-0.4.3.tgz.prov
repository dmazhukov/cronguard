annotations:
  artifacthub.io/category: monitoring-logging
  artifacthub.io/changes: |
    - kind: fixed
      description: Series scraped through the chart's ServiceMonitor carry the monitor's namespace again, not the operator's; alerts now route by the monitor's namespace
    - kind: added
      description: metrics.secure serves /metrics over TLS with a self-signed certificate generated at startup
    - kind: added
      description: config/observability kustomize overlay with the alerts and a ServiceMonitor for the raw manifests
